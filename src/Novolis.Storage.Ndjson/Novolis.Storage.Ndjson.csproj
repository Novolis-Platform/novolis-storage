<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Storage.Ndjson</PackageId>
    <Description>Typed append-only NDJSON store with tolerant reads and atomic replacement.</Description>
    <IsPackable>true</IsPackable>
    <RootNamespace>Novolis.Storage.Ndjson</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <LibraryReference Include="Novolis.IO.Ndjson" />
  </ItemGroup>
</Project>
